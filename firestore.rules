rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.superAdmin == true ||
        (request.auth.token.email == "jarreza_250000000100@uic.edu.ph" && request.auth.token.email_verified == true) ||
        (request.auth.token.email == "ais-sandbox@ais-asia-northeast1-f55682288c.iam.gserviceaccount.com" && request.auth.token.email_verified == true)
      );
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      allow create, update: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();

      match /sessions/{sessionId} {
        allow read, write: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      }

      match /interactions/{interactionId} {
        allow read: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
        allow create: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
        allow update, delete: if false;
      }

      match /summaries/{summaryId} {
        allow read, write: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      }
    }

    match /companyBasis/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /auditReports/{reportId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
